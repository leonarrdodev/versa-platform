{
  "name": "@versa/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false --include \"../../packages/*/dist/**/*\" src/main.ts",
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "test": "vitest run --config vitest.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "typecheck:integration": "tsc -p tsconfig.integration.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/pg": "^8.20.2",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@versa/database": "workspace:*",
    "@versa/event-contracts": "workspace:*",
    "@versa/observability": "workspace:*",
    "@versa/shared-kernel": "workspace:*",
    "pg": "^8.22.0"
  }
}